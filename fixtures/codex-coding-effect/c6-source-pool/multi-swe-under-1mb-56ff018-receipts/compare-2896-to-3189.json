ttps://api.github.com/repos/sharkdp/bat/commits/08047a6a2e5070836c7f0d1b4175c63fa0c5662e","html_url":"https://github.com/sharkdp/bat/commit/08047a6a2e5070836c7f0d1b4175c63fa0c5662e"}]},"status":"ahead","ahead_by":90,"behind_by":0,"total_commits":90,"commits":[{"sha":"3e5f4266ce4c7245650f1fc1cdb465b7c0b80700","node_id":"C_kwDOB8a8wdoAKDNlNWY0MjY2Y2U0YzcyNDU2NTBmMWZjMWNkYjQ2NWI3YzBiODA3MDA","commit":{"author":{"name":"Matt Helsley","email":"matt.helsley+oss@gmail.com","date":"2024-10-03T23:08:07Z"},"committer":{"name":"Matt Helsley","email":"matt.helsley+oss@gmail.com","date":"2024-10-03T23:32:23Z"},"message":"Fix lessopen feature\n\nRawOsString API changed in os_str_bytes 7.0.0 and bat no longer builds\nwith the lessopen feature because:\n\n- ::from_string() is deprecated and says to use new().\n  The documentation says that new(), like from_string() no longer\n  needs to copy the string.\n\n- ::assert_from_raw_vec() is no longer merely deprecated and now\n  requires selecting the \"conversions\" feature of os_str_bytes.\n\nReplaces PR#2938","tree":{"sha":"b5a6737e518330fad6b0c738e0556722a64845b0","url":"https://api.github.com/repos/sharkdp/bat/git/trees/b5a6737e518330fad6b0c738e0556722a64845b0"},"url":"https://api.github.com/repos/sharkdp/bat/git/commits/3e5f4266ce4c7245650f1fc1cdb465b7c0b80700","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/sharkdp/bat/commits/3e5f4266ce4c7245650f1fc1cdb465b7c0b80700","html_url":"https://github.com/sharkdp/bat/commit/3e5f4266ce4c7245650f1fc1cdb465b7c0b80700","comments_url":"https://api.github.com/repos/sharkdp/bat/commits/3e5f4266ce4c7245650f1fc1cdb465b7c0b80700/comments","author":null,"committer":null,"parents":[{"sha":"61c9f312c9d10103b33b7d8069401304ca938f06","url":"https://api.github.com/repos/sharkdp/bat/commits/61c9f312c9d10103b33b7d8069401304ca938f06","html_url":"https://github.com/sharkdp/bat/commit/61c9f312c9d10