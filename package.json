{
  "name": "goodmemory",
  "version": "0.7.5",
  "goodmemoryRelease": {
    "installCommandsApplyAfterPublish": true,
    "npmDistTag": "next",
    "status": "release-candidate"
  },
  "mcpName": "io.github.hjqcan/goodmemory",
  "description": "Memory layer for chat, copilot, and agent applications.",
  "license": "MIT",
  "homepage": "https://github.com/hjqcan/GoodMemory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjqcan/GoodMemory.git"
  },
  "bugs": {
    "url": "https://github.com/hjqcan/GoodMemory/issues"
  },
  "keywords": [
    "agents",
    "ai",
    "bun",
    "copilot",
    "llm",
    "memory",
    "node",
    "typescript"
  ],
  "type": "module",
  "workspaces": [
    "apps/inspector-web"
  ],
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".well-known/goodmemory.json",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "dist",
    "docs/README.md",
    "docs/GoodMemory-15-Minute-App-Integration.md",
    "docs/GoodMemory-0.6-to-0.7-Migration-Guide.md",
    "docs/GoodMemory-Claude-Code-Setup-Guide.md",
    "docs/GoodMemory-Codex-Handoff-Setup-Guide.md",
    "docs/GoodMemory-Cursor-Setup-Guide.md",
    "docs/GoodMemory-First-Principles-and-Reference-Architecture.md",
    "docs/GoodMemory-Gemini-CLI-Setup-Guide.md",
    "docs/GoodMemory-Inspector-and-Admin-API.md",
    "docs/GoodMemory-Kimi-Code-Setup-Guide.md",
    "docs/GoodMemory-LanguagePack-Extension-Guide.md",
    "docs/GoodMemory-MCP-Registry-Publishing.md",
    "docs/GoodMemory-OpenCode-Setup-Guide.md",
    "docs/GoodMemory-PRD.md",
    "docs/GoodMemory-Product-Comparison.md",
    "docs/GoodMemory-Python-HTTP-Integration-Bridge.md",
    "docs/GoodMemory-Reference-Integration-Guide.md",
    "docs/GoodMemory-Standalone-MCP-Setup-Guide.md",
    "docs/GoodMemory-Strategy-Rollout-Guide.md",
    "docs/GoodMemory-记忆数据分层设计.md",
    "llms.txt",
    "package.json",
    "scripts/goodmemory-cli.js",
    "scripts/goodmemory-http-bridge.js",
    "scripts/goodmemory-mcp.js",
    "server.json"
  ],
  "bin": {
    "goodmemory": "./scripts/goodmemory-cli.js",
    "goodmemory-http-bridge": "./scripts/goodmemory-http-bridge.js",
    "goodmemory-mcp": "./scripts/goodmemory-mcp.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "import": "./dist/ai-sdk/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./runtime-kit": {
      "types": "./dist/runtime-kit/index.d.ts",
      "import": "./dist/runtime-kit/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "bun run scripts/build-package.ts",
    "build:inspector-web": "bun run --cwd apps/inspector-web build",
    "build:types": "bunx tsc -p tsconfig.package.json",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "test": "bun test",
    "test:all": "bun --config=bunfig.all.toml test tests third-party",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:scenarios": "bun test tests/scenarios",
    "test:eval": "bun test tests/eval",
    "test:coverage": "bun run scripts/run-coverage.ts && bun run scripts/check-coverage.ts",
    "test:ci": "bun run typecheck && bun run test:coverage && bun run scripts/run-ci-post-coverage-tests.ts",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit",
    "goodmemory": "bun run scripts/goodmemory-cli.ts",
    "goodmemory:http-bridge": "bun run scripts/goodmemory-http-bridge.ts",
    "goodmemory:mcp": "bun run scripts/goodmemory-mcp.ts",
    "dev:inspector-fixture": "bun run scripts/run-phase-71-inspector-fixture.ts",
    "fixtures:generate": "bun run scripts/generate-eval-fixtures.ts",
    "example:chat": "bun run examples/basic-chat.ts",
    "example:coding-agent": "bun run examples/coding-agent.ts",
    "example:ai-sdk-server": "bun run examples/plain-ai-sdk-server.ts",
    "example:express-chat": "bun run examples/express-chat-server.ts",
    "example:fastify-chat": "bun run examples/fastify-chat-server.ts",
    "example:vercel-ai": "bun run examples/vercel-ai-chat.ts",
    "example:life-coach-profile": "bun run examples/life-coach-remember-profile.ts",
    "example:host-claude": "bun run examples/host-claude-artifacts.ts",
    "example:host-codex": "bun run examples/host-codex-handoff.ts",
    "example:reference-product": "bun run examples/reference-chat-product/backend.ts smoke",
    "eval:smoke": "bun run scripts/run-eval.ts --mode=smoke",
    "eval:fallback": "bun run scripts/run-eval.ts --mode=fallback",
    "eval:storage:cleanup": "bun run scripts/cleanup-eval-postgres.ts",
    "eval:official-rescore": "bun run scripts/rescore-official-protocols.ts",
    "gate:public-benchmark-claim": "bun run scripts/run-public-benchmark-claim-gate.ts",
    "verify:selection-refactor": "bun run scripts/verify-selection-refactor.ts",
    "eval:live": "bun run scripts/run-eval.ts --mode=live",
    "eval:live-memory": "bun run scripts/run-eval.ts --mode=live-memory",
    "eval:live-auto-memory": "bun run scripts/run-eval.ts --mode=live-auto-memory",
    "eval:live-provider-memory": "bun run scripts/run-eval.ts --mode=live-provider-memory",
    "eval:summary": "bun run scripts/summarize-eval.ts",
    "research:list": "bun scripts/research.ts list",
    "research:run": "bun scripts/research.ts run",
    "research:verify": "bun scripts/research.ts verify",
    "gate:projection-storage-scale": "bun scripts/run-projection-storage-scale-gate.ts",
    "release:prepare": "bun scripts/release.ts prepare",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.0.0",
    "hyparquet": "1.26.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.64",
    "@ai-sdk/openai": "3.0.49",
    "@ai-sdk/openai-compatible": "2.0.40",
    "@ai-sdk/provider-utils": "4.0.23",
    "@modelcontextprotocol/server": "^2.0.0",
    "ai": "6.0.143",
    "sqlite-vss": "0.1.2",
    "zod": "^4.3.6"
  }
}
